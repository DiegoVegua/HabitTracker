# Copiez ce fichier en .env.local et remplissez les valeurs depuis
# votre projet Supabase : Dashboard > Project Settings > API

# URL du projet (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (safe côté client, protégée par les RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de base du site, utilisée pour les redirections OAuth.
# En local : http://localhost:3000 — en prod : https://votre-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
